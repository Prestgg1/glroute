# glroute Environment Configuration Example

# Port for the OpenAI-compatible server (default: 3000)
GLROUTE_PORT=3000

# Optional Server API Key: If set, client requests must pass "Authorization: Bearer <GLROUTE_API_KEY>"
GLROUTE_API_KEY=your_secret_glroute_key_here

# Allowed Origin for CORS (e.g., https://yourfrontend.com or * for all)
GLROUTE_ALLOWED_ORIGIN=*

# LLM Provider API Keys (Used when building agents)
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIzaSy...
